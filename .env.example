# Cấu hình môi trường cho Hệ thống Quản lý Công việc & Phân công bằng Học máy (HUIT CNTT-KLCN184)

# 1. Cơ sở dữ liệu (SQL Server LocalDB trên Windows; SQL Server container trong Docker)
DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver={ODBC Driver 17 for SQL Server};Server=(localdb)\MSSQLLocalDB;Database=qlcv;Trusted_Connection=yes;

# 2. Bảo mật JWT
JWT_SECRET=khoa-bi-mat-khoa-luan-cntt-klcn184-2026-2027
JWT_EXPIRE_MINUTES=480

# 3. Dịch vụ Học máy (ML Service)
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_SECONDS=4
ML_BACKGROUND_TIMEOUT_SECONDS=120

# 4. Lịch năm học & Nhắc nhở
ACADEMIC_YEAR_START=08-15
REMINDER_DAYS=3,1
SCHEDULER_ENABLED=1

# 5. Giao diện (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO
